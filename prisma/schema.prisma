generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum FitType {
  REGULAR
  RELAXED
  OVERSIZED
  LOOSE
  BOOTCUT
  WIDE_LEG
}

enum StyleTag {
  STREETWEAR
  MINIMAL
  AESTHETIC
  CLASSIC
}

enum ProductSize {
  S
  M
  L
  XL

  SIZE_26 @map("26")
  SIZE_28 @map("28")
  SIZE_30 @map("30")
  SIZE_32 @map("32")
  SIZE_34 @map("34")

  UK_6
  UK_7
  UK_8
  UK_9
  UK_10

  ONE_SIZE
}

enum ProductColor {
  BLACK
  WHITE
  GREY
  CHARCOAL
  BROWN
  BEIGE
  CREAM
  OLIVE
  GREEN
  BLUE
  NAVY
  RED
  MAROON
  PINK
  PURPLE
  YELLOW
  ORANGE
  MULTICOLOR
}

model Category {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  description   String?
  isActive      Boolean       @default(true)
  subCategories SubCategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model SubCategory {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
  products    Product[]
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([categoryId, name])
  @@index([categoryId, isActive])
}

model Product {
  id            Int              @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal          @db.Decimal(10, 2)
  imageUrl      String?
  colors        ProductColor[]
  fit           FitType?
  styleTags     StyleTag[]       @default([])
  subCategoryId Int
  subCategory   SubCategory      @relation(fields: [subCategoryId], references: [id])
  variants      ProductVariant[]
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model ProductVariant {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      ProductSize
  sku       String       @unique
  stock     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, size])
}
